FROM ubuntu:22.04

ARG CONTRACT_TAG=v1.2.4 # https://github.com/bnb-chain/bsc-genesis-contract/tags
ARG NPM_VERSION=v22.4.1 # need something decent, unlike it says in bsc-genesis-contract repo...
ARG FORGE_VERSION=v1.7.3 # from https://github.com/bnb-chain/bsc-genesis-contract?tab=readme-ov-file#prepare
ARG GETH_VERSION=v1.7.1 # https://github.com/bnb-chain/bsc/releases/

RUN apt-get update && apt-get -y install ca-certificates python3 git curl build-essential jq

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.2/install.sh | bash

#RUN echo 'export NVM_DIR="$HOME/.nvm" && . $NVM_DIR/nvm.sh' >> ~/.profile

# use bash as shell, loading the .profile
SHELL ["/bin/bash", "-c", "-i"]

RUN nvm install $NPM_VERSION && nvm use $NPM_VERSION

RUN git clone https://github.com/bnb-chain/bsc-genesis-contract.git --branch $CONTRACT_TAG /root/genesis \
    && rm /root/genesis/package-lock.json && cd /root/genesis && npm install


RUN curl -sSL https://install.python-poetry.org | python3 -

RUN echo 'export PATH="/root/.local/bin:$PATH"' >> ~/.bashrc
RUN cd /root/genesis && poetry install

RUN  curl -L https://foundry.paradigm.xyz | bash
# The installer only appends to ~/.bashrc; later RUN layers need foundryup and forge on PATH.
ENV PATH="/root/.foundry/bin:${PATH}"
# forge install --no-git broke with newer foundry ("not a git repository:
# ../../.git/modules/lib/ds-test"); vendor forge-std (and its ds-test dep) manually.
RUN cd /root/genesis && foundryup \
    && rm -rf lib/forge-std \
    && git clone --depth 1 --branch $FORGE_VERSION https://github.com/foundry-rs/forge-std lib/forge-std \
    && git clone --depth 1 https://github.com/dapphub/ds-test lib/forge-std/lib/ds-test \
    && rm -rf lib/forge-std/.git lib/forge-std/lib/ds-test/.git

WORKDIR /root/genesis
RUN poetry run python -m scripts.generate dev

# activate pascal, lorentz and maxwell
RUN jq '.config.berlinBlock = 8 | .config.hertzfixBlock = 8 | .config.londonBlock = 8 | .config.hertzBlock = 8 | .config.lorentzTime = 0 | .config.pascalTime = 0 | .config.parlia.period = 1 | .config.bohrTime = 0 | .config.haberFixTime = 0 | .config.haberTime = 0 | .config.cancunTime = 0 | .config.feynmanFixTime = 0 | .config.pragueTime = 0 | .config.maxwellTime = 0 | .config.blobSchedule = { "cancun": { "target": 3, "max": 6, "baseFeeUpdateFraction": 3338477 }, "prague": { "target": 6, "max": 9, "baseFeeUpdateFraction": 5007716 }}'  genesis.json> genesis.json.new && mv genesis.json.new genesis.json
#COPY genesis.json.example genesis.json

# JENNER=true (needs GETH_VERSION >= v1.8.1) also activates Fermi through Jenner. BSC gates
# timestamp forks on London, so block 8 is the Jenner transition block that plants the CAS20
# registry sentinels. The dev chain is not Rialto, so no system-contract upgrade installs the
# PaymentLane contract: the genesis carries Rialto's bytecode instead (empty storage is its default
# configuration). CAS20_ADMIN is written as the ActivationRegistry admin so tests can open features.
ARG JENNER=false
ARG CAS20_ADMIN=0x821b55d8abe79bc98f05eb675fdc50dfe796b7ab
RUN if [ "$JENNER" = "true" ]; then \
      curl -sSfL -o /tmp/payment-lane https://raw.githubusercontent.com/bnb-chain/bsc/$GETH_VERSION/core/systemcontracts/jenner/rialto/PaymentLaneContract \
      && jq --arg lane "0x$(tr -d '\n' < /tmp/payment-lane)" \
            --arg admin "0x000000000000000000000000${CAS20_ADMIN#0x}" \
            '.config.fermiTime = 0 | .config.osakaTime = 0 | .config.mendelTime = 0 | .config.pasteurTime = 0 | .config.jennerTime = 0 \
             | .config.blobSchedule.osaka = .config.blobSchedule.prague \
             | .alloc["0x0000000000000000000000000000000000002007"] = { "balance": "0x0", "code": $lane } \
             | .alloc["0x7020000000000000000000000000000000000001"] = { "balance": "0x0", "storage": { "0xa8970030726ea4c1e5fe64bf3ba11683da0b59f818265a7369e5570e9fc0bd01": $admin } }' \
            genesis.json > genesis.json.new \
      && mv genesis.json.new genesis.json; \
    fi

RUN uname -i |grep "aarch64" && binary="geth_linux" || binary="geth-linux-arm64"; curl -L -o /usr/local/bin/geth https://github.com/bnb-chain/bsc/releases/download/$GETH_VERSION/$binary && chmod +x /usr/local/bin/geth


RUN geth init genesis.json
RUN geth account import --password=/dev/null <(echo 9b28f36fbd67381120752d6172ecdcf10e06ab2d9a1367aac00cdcd6ac7855d3)

CMD geth --mine --miner.etherbase=0x9fB29AAc15b9A4B7F17c3385939b007540f4d791 --unlock=0x9fB29AAc15b9A4B7F17c3385939b007540f4d791 --password=/dev/null --allow-insecure-unlock --http --http.api=eth,net,web3,debug,admin --http.addr=0.0.0.0 --port=30304 --miner.gasprice=1 --txpool.pricelimit=1

EXPOSE 30304
EXPOSE 8545
